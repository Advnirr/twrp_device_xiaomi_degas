From: nyxianglyph <nyxianglyph@gmail.com>
Subject: [PATCH] vold: AIDL Weaver support

TWRP vold only talks to the HIDL weaver@1.0 HAL; degas' NXP weaver is AIDL
(android.hardware.weaver.IWeaver/default v2), so PIN decryption failed with
"Failed to get weaver service". Weaver hunks from OrangeFox
patches/patch-vold-fox_14.1.diff, plus: only wait for the AIDL instance when
VINTF declares it (AServiceManager_isDeclared), and include Weaver1.h after
the libchrome headers (logging macro clash). Verified on device 2026-11-21.
---
diff --git a/Android.bp b/Android.bp
index 200eb67..4110906 100644
--- a/Android.bp
+++ b/Android.bp
@@ -181,6 +181,7 @@ cc_library_static {
         "android.hardware.keymaster@4.1",
         "android.hardware.security.keymint-V3-ndk",
         "android.hardware.weaver@1.0",
+        "android.hardware.weaver-V2-ndk",
         "android.security.apc-ndk",
         "android.system.keystore2-V4-ndk",
         "android.security.authorization-ndk",
diff --git a/Decrypt.cpp b/Decrypt.cpp
index 0a5afb0..4d29e55 100755
--- a/Decrypt.cpp
+++ b/Decrypt.cpp
@@ -28,7 +28,6 @@
 #include <sys/types.h>
 
 #include <keyutils.h>
-#include "Weaver1.h"
 #include "cutils/properties.h"
 
 #include <openssl/sha.h>
@@ -83,6 +82,9 @@ extern "C" {
 #include "HashPassword.h"
 #include "KeystoreInfo.hpp"
 #include "KeyStorage.h"
+// After the libchrome/keystore headers: the AIDL IWeaver header pulls in
+// android-base logging, whose macros clash with libchrome base/logging.h.
+#include "Weaver1.h"
 #include "android/os/IVold.h"
 
 namespace apc = ::aidl::android::security::apc;
diff --git a/Weaver1.cpp b/Weaver1.cpp
index ea357ed..959b9cb 100644
--- a/Weaver1.cpp
+++ b/Weaver1.cpp
@@ -28,7 +28,10 @@
 //#include <keystore/authorization_set.h>
 //#include <keystore/keystore_hidl_support.h>
 
+#include <android/binder_manager.h>
+
 #include <android/hardware/weaver/1.0/IWeaver.h>
+#include <aidl/android/hardware/weaver/IWeaver.h>
 
 #include <iostream>
 #define ERROR 1
@@ -48,7 +51,19 @@ namespace android {
 namespace vold {
 
 Weaver::Weaver() {
-	mDevice = ::android::hardware::weaver::V1_0::IWeaver::getService();
+    // AIDL Weaver first (Android 13+ HALs, e.g. NXP weaver-service on degas);
+    // only wait for it when the VINTF manifest declares it, otherwise
+    // AServiceManager_waitForService would block forever on HIDL-only devices.
+    const std::string instance = std::string(::aidl::android::hardware::weaver::IWeaver::descriptor) + "/default";
+    if (AServiceManager_isDeclared(instance.c_str())) {
+        AIBinder* binder = AServiceManager_waitForService(instance.c_str());
+        mAidlDevice = ::aidl::android::hardware::weaver::IWeaver::fromBinder(ndk::SpAIBinder(binder));
+        if (mAidlDevice == nullptr)
+            printf("AIDL weaver %s declared but not available\n", instance.c_str());
+    }
+	if (mAidlDevice == nullptr) {
+		mDevice = ::android::hardware::weaver::V1_0::IWeaver::getService();
+	}
 	GottenConfig = false;
 }
 
@@ -56,6 +71,15 @@ bool Weaver::GetConfig() {
 	if (GottenConfig)
 		return true;
 
+	if (mAidlDevice != nullptr) {
+		auto r = mAidlDevice->getConfig(&aidlConfig);
+		if (r.isOk()) {
+			GottenConfig = true;
+			return true;
+		}
+		return false;
+	}
+
 	WeaverStatus status;
 	WeaverConfig cfg;
 
@@ -76,6 +100,10 @@ bool Weaver::GetConfig() {
 bool Weaver::GetSlots(uint32_t* slots) {
 	if (!GetConfig())
 		return false;
+	if (mAidlDevice != nullptr) {
+		*slots = aidlConfig.slots;
+		return true;
+	}
 	*slots = config.slots;
 	return true;
 }
@@ -83,6 +111,10 @@ bool Weaver::GetSlots(uint32_t* slots) {
 bool Weaver::GetKeySize(uint32_t* keySize) {
 	if (!GetConfig())
 		return false;
+	if (mAidlDevice != nullptr) {
+		*keySize = aidlConfig.keySize;
+		return true;
+	}
 	*keySize = config.keySize;
 	return true;
 }
@@ -90,6 +122,10 @@ bool Weaver::GetKeySize(uint32_t* keySize) {
 bool Weaver::GetValueSize(uint32_t* valueSize) {
 	if (!GetConfig())
 		return false;
+	if (mAidlDevice != nullptr) {
+		*valueSize = aidlConfig.valueSize;
+		return true;
+	}
 	*valueSize = config.valueSize;
 	return true;
 }
@@ -111,6 +147,17 @@ bool Weaver::WeaverVerify(const uint32_t slot, const void* weaver_key, std::vect
 		key[index] = *ptr;
 		ptr++;
 	}
+
+	if (mAidlDevice != nullptr) {
+		::aidl::android::hardware::weaver::WeaverReadResponse rep;
+		auto r = mAidlDevice->read(slot, key, &rep);
+		if (r.isOk() && rep.status == ::aidl::android::hardware::weaver::WeaverReadStatus::OK) {
+			*payload = rep.value;
+			return true;
+		}
+		return false;
+	}
+
 	const auto readRet = mDevice->read(slot, key, [&](WeaverReadStatus s, WeaverReadResponse r) {
 		callbackCalled = true;
 		status = s;
diff --git a/Weaver1.h b/Weaver1.h
index 22f401e..4a329cb 100644
--- a/Weaver1.h
+++ b/Weaver1.h
@@ -29,6 +29,7 @@
 #include <utility>
 
 #include <android/hardware/weaver/1.0/IWeaver.h>
+#include <aidl/android/hardware/weaver/IWeaver.h>
 #include "Utils.h"
 
 namespace android {
@@ -40,7 +41,7 @@ class Weaver {
 	public:
 		Weaver();
 		// false if we failed to open the weaver device.
-		explicit operator bool() { return mDevice.get() != nullptr; }
+		explicit operator bool() { return (mDevice.get() != nullptr) || (mAidlDevice != nullptr); }
 
 		bool GetSlots(uint32_t* slots);
 		bool GetKeySize(uint32_t* keySize);
@@ -50,7 +51,10 @@ class Weaver {
 
 	private:
 		sp<hardware::weaver::V1_0::IWeaver> mDevice;
+		std::shared_ptr<::aidl::android::hardware::weaver::IWeaver> mAidlDevice;
+
 		hardware::weaver::V1_0::WeaverConfig config;
+		::aidl::android::hardware::weaver::WeaverConfig aidlConfig;
 		bool GottenConfig;
 
 		bool GetConfig();
