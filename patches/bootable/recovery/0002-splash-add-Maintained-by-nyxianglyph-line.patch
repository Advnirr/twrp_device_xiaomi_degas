Cosmetic attribution on the portrait_hdpi splash screen, below the version.
---
 gui/theme/portrait_hdpi/splash.xml | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/gui/theme/portrait_hdpi/splash.xml b/gui/theme/portrait_hdpi/splash.xml
index f793afaa..e9763edb 100644
--- a/gui/theme/portrait_hdpi/splash.xml
+++ b/gui/theme/portrait_hdpi/splash.xml
@@ -45,6 +45,12 @@
 				<placement x="540" y="1590" placement="5"/>
 				<text>Recovery Project %tw_version%</text>
 			</text>
+
+			<text color="%accent_color%">
+				<font resource="font_l"/>
+				<placement x="540" y="1660" placement="5"/>
+				<text>Maintained by nyxianglyph</text>
+			</text>
 		</page>
 	</pages>
 </recovery>
