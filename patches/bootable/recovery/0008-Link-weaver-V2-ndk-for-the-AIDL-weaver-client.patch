From: nyxianglyph <nyxianglyph@gmail.com>
Subject: [PATCH] Link weaver-V2-ndk for the AIDL weaver client

libvold now uses the AIDL weaver NDK interface (system/vold patch 0001);
libtar.so and recovery link libvold statically and need the shared library
on their own link line.
---
diff --git a/Android.mk b/Android.mk
index f593a07..1f2784a 100755
--- a/Android.mk
+++ b/Android.mk
@@ -350,6 +350,8 @@ ifeq ($(TW_INCLUDE_CRYPTO), true)
 
     LOCAL_STATIC_LIBRARIES += libkeymint_support libasync_safe libdm
     LOCAL_SHARED_LIBRARIES += libsysutils
+    # AIDL weaver client in libvold (vold patch 0001)
+    LOCAL_SHARED_LIBRARIES += android.hardware.weaver-V2-ndk
 
     LOCAL_CFLAGS += -DTW_INCLUDE_FBE_METADATA_DECRYPT
 
diff --git a/libtar/Android.mk b/libtar/Android.mk
index 82ca4f9..663e134 100755
--- a/libtar/Android.mk
+++ b/libtar/Android.mk
@@ -16,6 +16,8 @@ LOCAL_SHARED_LIBRARIES += libselinux
 ifeq ($(TW_INCLUDE_CRYPTO_FBE), true)
     LOCAL_STATIC_LIBRARIES += libvold libscrypt_static libasync_safe
     LOCAL_SHARED_LIBRARIES += libboot_control_client libsysutils
+    # AIDL weaver client in libvold (vold patch 0001)
+    LOCAL_SHARED_LIBRARIES += android.hardware.weaver-V2-ndk
     LOCAL_SHARED_LIBRARIES +=  \
         android.hardware.boot@1.0 \
         android.hardware.confirmationui@1.0 \
